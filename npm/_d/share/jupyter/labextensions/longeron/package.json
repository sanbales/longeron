{
  "name": "longeron",
  "version": "0.10.0",
  "description": "JupyterLab launcher tile for Longeron: define, execute, and replay SysML v2 models. Python package: `pip install longeron` (the wheel ships this prebuilt extension).",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "sysml",
    "kerml",
    "mbse",
    "systems-engineering"
  ],
  "homepage": "https://github.com/sanbales/longeron",
  "bugs": {
    "url": "https://github.com/sanbales/longeron/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanbales/longeron.git"
  },
  "license": "Apache-2.0",
  "author": "sanbales",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.{js,js.map,d.ts,json}",
    "src/**/*.ts",
    "install.json"
  ],
  "scripts": {
    "build": "jlpm build:lib && jlpm build:ext",
    "build:ext": "jupyter labextension build .",
    "build:lib": "tsc -b",
    "clean": "rm -rf lib tsconfig.tsbuildinfo _d",
    "watch": "jupyter labextension watch ."
  },
  "dependencies": {
    "@jupyterlab/application": "^4.1.0",
    "@jupyterlab/apputils": "^4.1.0",
    "@jupyterlab/console": "^4.1.0",
    "@jupyterlab/launcher": "^4.1.0",
    "@jupyterlab/services": "^7.1.0",
    "@jupyterlab/ui-components": "^4.1.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.1.0",
    "typescript": "~5.2.2"
  },
  "sideEffects": false,
  "jupyterlab": {
    "extension": true,
    "outputDir": "_d/share/jupyter/labextensions/longeron",
    "_build": {
      "load": "static/remoteEntry.0b85544279bede582c04.js",
      "extension": "./extension"
    }
  }
}
