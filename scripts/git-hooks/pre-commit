#!/usr/bin/env python3
"""pre-commit: auto-strip notebook outputs from STAGED blobs (stdlib only).

Convention: notebooks may carry outputs in the working tree while you
explore, but commits are always stripped. Refusal-era versions of this
hook (ported from earlier internal tooling) made you re-run
``scripts/run_notebooks.py --strip-only`` and re-stage by hand; this
version (pattern from upstream tooling ``scripts/pre-commit``) instead
rewrites only the INDEX entry (``git hash-object`` + ``git
update-index``), so the commit is clean and the working tree -- including
the outputs you are looking at -- survives untouched.

What gets stripped from every staged ``.ipynb``: cell outputs, execution
counts, per-cell ``metadata.execution`` timestamps, and the
``metadata.widgets`` state blob. Tutorials under ``notebooks/`` are
additionally normalized exactly like ``scripts/run_notebooks.py::strip``
(``language_info``, collapsed/scrolled flags, kernelspec name churn) so
hook-stripped and script-stripped commits are byte-identical. Vendored
notebooks (``vendor/``) only get the output strip, staying as close to
upstream as possible.

Also refuses any staged blob over MAX_STAGED_BYTES (5 MB, checked
post-strip). Deliberate large assets are a conscious choice: bypass with
``git commit --no-verify`` and say why in the commit message.

Enable once per clone:  git config core.hooksPath scripts/git-hooks
(or: make hooks / pixi run hooks)
"""

from __future__ import annotations

import json
import subprocess
import sys

MAX_STAGED_BYTES = 5 * 1024 * 1024

#: notebook-level metadata keys that churn without carrying information
#: (keep in sync with scripts/run_notebooks.py)
_VOLATILE_NOTEBOOK_METADATA = ("widgets", "language_info")
_VOLATILE_CELL_METADATA = ("execution", "collapsed", "scrolled")


def staged_paths() -> list[str]:
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM", "-z"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    return [p for p in out.split("\0") if p]


def staged_blob(path: str) -> bytes:
    return subprocess.run(["git", "show", f":{path}"], capture_output=True, check=True).stdout


def staged_mode(path: str) -> str:
    out = subprocess.run(
        ["git", "ls-files", "--stage", "--", path],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    return out.split()[0] if out else "100644"


def strip_notebook(blob: bytes, full: bool) -> tuple[bytes, list[str]]:
    """Return (stripped_json_bytes, human summary of what was stripped).

    ``full`` applies the whole run_notebooks.py normalization (repo
    tutorials); otherwise only outputs/execution state are removed
    (vendored notebooks stay upstream-pristine).
    """

    nb = json.loads(blob)
    stripped: list[str] = []
    n_outputs = n_counts = n_meta = 0
    for cell in nb.get("cells", []):
        if cell.get("cell_type") != "code":
            continue
        if cell.get("outputs"):
            n_outputs += len(cell["outputs"])
            cell["outputs"] = []
        if cell.get("execution_count") is not None:
            n_counts += 1
            cell["execution_count"] = None
        meta = cell.get("metadata", {})
        for key in _VOLATILE_CELL_METADATA if full else ("execution",):
            if key in meta:
                n_meta += 1
                del meta[key]
    if n_outputs:
        stripped.append(f"{n_outputs} output block(s)")
    if n_counts:
        stripped.append(f"{n_counts} execution_count(s)")
    if n_meta:
        stripped.append(f"{n_meta} volatile cell metadata key(s)")
    nb_meta = nb.get("metadata", {})
    keys = _VOLATILE_NOTEBOOK_METADATA if full else ("widgets",)
    for key in keys:
        if key in nb_meta:
            del nb_meta[key]
            stripped.append(f"metadata.{key}")
    kernelspec = nb_meta.get("kernelspec")
    if full and kernelspec is not None:
        if (kernelspec.get("display_name"), kernelspec.get("name")) != (
            "Python 3",
            "python3",
        ):
            kernelspec["display_name"] = "Python 3"
            kernelspec["name"] = "python3"
            stripped.append("kernelspec churn")
    if not stripped:
        return blob, []
    # byte-identical to nbformat.write (indent=1, sorted, no ascii escapes)
    text = json.dumps(nb, indent=1, sort_keys=True, separators=(",", ": "), ensure_ascii=False)
    return (text + "\n").encode("utf-8"), stripped


def restage(path: str, content: bytes) -> None:
    """Replace the INDEX entry for *path* without touching the working tree."""

    blob_hash = (
        subprocess.run(
            ["git", "hash-object", "-w", "--stdin"],
            input=content,
            capture_output=True,
            check=True,
        )
        .stdout.decode()
        .strip()
    )
    subprocess.run(
        ["git", "update-index", "--cacheinfo", f"{staged_mode(path)},{blob_hash},{path}"],
        check=True,
    )


def main() -> int:
    failures: list[str] = []
    for path in staged_paths():
        if staged_mode(path) == "120000":
            continue  # symlink: the blob is the target path, not content
        blob = staged_blob(path)
        if path.endswith(".ipynb"):
            try:
                blob, what = strip_notebook(blob, full=not path.startswith("vendor/"))
            except (json.JSONDecodeError, KeyError, TypeError, AttributeError) as e:
                failures.append(f"{path}: could not parse/strip notebook ({e!r})")
                continue
            if what:
                restage(path, blob)
                print(
                    f"pre-commit: stripped {', '.join(what)} from staged "
                    f"{path} (working tree untouched)"
                )
        if len(blob) > MAX_STAGED_BYTES:
            failures.append(
                f"{path}: staged blob is {len(blob) / 1e6:.1f} MB "
                f"(cap {MAX_STAGED_BYTES / 1e6:.0f} MB)"
            )
    if failures:
        print("pre-commit: REFUSING the commit:", file=sys.stderr)
        for failure in failures:
            print(f"  - {failure}", file=sys.stderr)
        print(
            "\ndeliberate large asset: git commit --no-verify (say why in the message)",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
